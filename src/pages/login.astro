---
import RootLayout from '../layouts/RootLayout.astro';
import AuthIsland from '../components/islands/AuthIsland';
import HeroBackground from '../components/ui/HeroBackground.astro';
---

<RootLayout
  title="Masuk ke Akun | TOMORROW X TOGETHER Official Portal"
  description="Masuk ke akun official Tomorrow X Together (TXT) MOA untuk akses album eksklusif, tur, dan merchandise resmi."
  hideNavbar={true}
>
  <div class="relative min-h-screen py-12 px-4 sm:px-6 flex items-center justify-center overflow-hidden bg-[#0a0a0a]">
    <HeroBackground
      topSubtitle="OFFICIAL MOA ACCESS"
      largeTextPrimary="TOMORROW X TOGETHER"
      largeTextSecondary="THE NAME CHAPTER • PROMISE"
    />

    <div class="relative z-10 w-full max-w-md mx-auto">
      <div class="mb-4 flex items-center justify-between text-xs text-neutral-400">
        <a href="/" class="inline-flex items-center gap-1.5 hover:text-white transition-colors group">
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          <span>Kembali ke Beranda</span>
        </a>
        <span class="font-mono text-[11px] text-neutral-500">TOMORROW X TOGETHER</span>
      </div>

      <AuthIsland client:load initialMode="login" />
    </div>
  </div>
</RootLayout>
