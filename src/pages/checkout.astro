---
import RootLayout from '../layouts/RootLayout.astro';
import CheckoutIsland from '../components/islands/CheckoutIsland';
---

<RootLayout
  title="Ringkasan Pembelian & Checkout | TOMORROW X TOGETHER"
  description="Ringkasan pembelian merchandise resmi TOMORROW X TOGETHER, pilihan metode pembayaran, dan alamat pengiriman."
  solidHeader={true}
>
  <div class="relative min-h-[calc(100vh-80px)] pt-28 pb-24 px-4 sm:px-6 max-w-7xl mx-auto overflow-hidden bg-[#0a0a0a]">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff08_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
    <div class="absolute top-20 right-1/4 w-[500px] h-[350px] bg-[#F8138D]/10 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-20 left-10 w-[400px] h-[300px] bg-[#00c5c8]/5 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative z-10 mb-4">
      <div class="flex items-center justify-between text-xs text-neutral-400">
        <a href="/store" class="inline-flex items-center gap-1.5 hover:text-white transition-colors group">
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          <span>Kembali ke Store</span>
        </a>
        <div class="flex items-center gap-3">
          <a href="/" class="hover:text-[#F8138D] transition-colors">Beranda</a>
          <span class="text-neutral-600">•</span>
          <a href="/store" class="hover:text-[#F8138D] transition-colors">Official Merch</a>
        </div>
      </div>
    </div>

    <div class="relative z-10">
      <CheckoutIsland client:load />
    </div>
  </div>
</RootLayout>
