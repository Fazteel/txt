---
import RootLayout from '../layouts/RootLayout.astro';
import ProfileIsland from '../components/islands/ProfileIsland';
import SectionHeading from '../components/ui/SectionHeading.astro';
---

<RootLayout
  title="My MOA Fan Profile & Digital Pass | TOMORROW X TOGETHER"
  description="Manage your official Tomorrow X Together MOA digital fan pass, update your member bias, and explore exclusive perks."
  solidHeader={true}
>
  <div class="relative min-h-[calc(100vh-80px)] pt-32 pb-24 px-4 sm:px-8 max-w-7xl mx-auto overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff08_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none" />
    <div class="absolute top-20 right-1/4 w-[500px] h-[300px] bg-[#F8138D]/10 rounded-full blur-[140px] pointer-events-none" />

    <div class="relative z-10 mb-10">
      <SectionHeading
        subtitle="Official Membership"
        title="MOA DIGITAL ACCESS"
        align="left"
      />
      <p class="max-w-xl text-neutral-400 text-sm leading-relaxed -mt-6">
        Your verified digital pass for the Tomorrow X Together global fan community.
      </p>
    </div>

    <div class="relative z-10">
      <ProfileIsland client:load />
    </div>
  </div>
</RootLayout>
