---
import SectionHeading from '../ui/SectionHeading.astro';
import membersData from '../../data/members.json';
---

<section id="members-pinned-section" class="relative bg-[#0d0d10] py-24 overflow-hidden border-t border-white/5">
  {/* Header & Lore container */}
  <div class="max-w-7xl mx-auto px-6 mb-12">
    <SectionHeading
      subtitle="We are"
      title="TOMORROW X TOGETHER"
      align="left"
    />
    <p class="max-w-2xl text-neutral-400 text-sm sm:text-base leading-relaxed">
      TOMORROW X TOGETHER, read as ‘tomorrow by together’, is a bright and youthful boyband aiming to become the next global breakthrough artist. The band is composed of five members, SOOBIN, YEONJUN, BEOMGYU, TAEHYUN, HUENINGKAI, where each member is different from one another, shining in their own way to create synergy.
    </p>
  </div>

  {/* Horizontal Scroll Track Wrapper */}
  <div id="members-pin-container" class="relative w-full overflow-hidden">
    <div
      id="members-track"
      class="flex gap-6 sm:gap-8 px-6 sm:px-12 w-max items-center py-6 select-none"
    >
      {
        membersData.map((member, index) => (
          <div
            class="member-card relative w-[300px] sm:w-[360px] h-[520px] sm:h-[580px] rounded-2xl bg-[#141418] border border-white/10 overflow-hidden flex flex-col justify-end p-6 sm:p-8 transition-all duration-500 hover:border-[#00e5ff]/50 hover:shadow-[0_15px_40px_rgba(0,229,255,0.15)] group cursor-pointer"
            data-member-id={member.id}
          >
            {/* Background Member Portrait with Zoom effect */}
            <div class="absolute inset-0 z-0 overflow-hidden">
              <img
                src={member.image}
                alt={member.stageName}
                class="w-full h-full object-cover object-top filter grayscale contrast-110 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0e0e12] via-[#0e0e12]/60 to-transparent z-10" />
            </div>

            {/* Top Index & Accent */}
            <div class="relative z-20 flex justify-between items-start mb-auto">
              <span class="text-xs font-mono font-bold tracking-widest text-[#00e5ff] uppercase px-2.5 py-1 bg-black/60 rounded-full border border-white/10 backdrop-blur-md">
                0{index + 1} // 05
              </span>
              <span class="text-2xl font-light text-white/30 group-hover:text-[#00e5ff] transition-colors">
                +
              </span>
            </div>

            {/* Member Details Overlay */}
            <div class="relative z-20 space-y-3">
              <div>
                <span class="text-[11px] font-mono tracking-widest uppercase text-[#00e5ff]">
                  {member.role}
                </span>
                <h3 class="text-3xl sm:text-4xl font-display font-black tracking-tight text-white uppercase group-hover:translate-x-1 transition-transform">
                  {member.stageName}
                </h3>
                <p class="text-xs text-neutral-400 font-medium">
                  {member.fullName} • Born {member.birthDate}
                </p>
              </div>

              {/* Quote signature */}
              <div class="pt-3 border-t border-white/10">
                <p class="text-xs text-neutral-300 italic font-light leading-relaxed">
                  "{member.quote}"
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHorizontalPin() {
    const section = document.getElementById('members-pinned-section');
    const container = document.getElementById('members-pin-container');
    const track = document.getElementById('members-track');

    if (!section || !container || !track) return;

    // Only apply horizontal scroll pinning on desktop/tablet where track exceeds container
    const updatePin = () => {
      ScrollTrigger.getAll().forEach((st) => {
        if (st.vars.id === 'members-horizontal-pin') {
          st.kill();
        }
      });

      const totalScrollWidth = track.scrollWidth - window.innerWidth;
      if (totalScrollWidth > 0 && window.innerWidth >= 768) {
        gsap.to(track, {
          x: () => -totalScrollWidth - 60,
          ease: 'none',
          scrollTrigger: {
            id: 'members-horizontal-pin',
            trigger: section,
            pin: true,
            scrub: 1,
            start: 'center center',
            end: () => `+=${totalScrollWidth + 300}`,
            invalidateOnRefresh: true,
          },
        });
      } else {
        gsap.set(track, { clearProps: 'transform' });
      }
    };

    updatePin();
    window.addEventListener('resize', updatePin);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHorizontalPin);
  } else {
    initHorizontalPin();
  }
</script>
