---
import SectionHeading from '../ui/SectionHeading.astro';
import membersData from '../../data/members.json';
---

<section id="members-pinned-section" class="relative bg-[#0d0d10] pt-8 pb-10 sm:pt-10 sm:pb-12 overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 mb-4 sm:mb-6 flex flex-col md:flex-row md:items-end justify-between gap-3">
    <div>
      <div class="flex items-center gap-2 text-xs font-mono font-semibold tracking-[0.25em] uppercase text-[#F8138D] mb-1">
        <span class="w-2 h-0.5 bg-[#F8138D]"></span>
        <span>We are</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-black tracking-tight text-white uppercase">
        TOMORROW X TOGETHER
      </h2>
      <p class="max-w-xl text-neutral-400 text-xs sm:text-sm leading-relaxed mt-1 line-clamp-2">
        TOMORROW X TOGETHER is a bright and youthful boyband composed of five members: SOOBIN, YEONJUN, BEOMGYU, TAEHYUN, and HUENINGKAI.
      </p>
    </div>

  </div>

  <div id="members-pin-container" class="relative w-full overflow-x-auto md:overflow-hidden scrollbar-none snap-x snap-mandatory scroll-smooth">
    <div
      id="members-track"
      class="flex gap-4 sm:gap-6 px-4 sm:px-12 w-max items-center py-2 select-none"
    >
      {
        membersData.map((member, index) => (
          <div
            class="member-card snap-center shrink-0 relative w-[80vw] max-w-[280px] sm:w-[300px] rounded-2xl bg-[#141418] border border-white/10 overflow-hidden flex flex-col transition-all duration-500 hover:border-[#F8138D]/60 hover:shadow-[0_20px_45px_rgba(248,19,141,0.25)] hover:-translate-y-1 group cursor-pointer"
            data-member-id={member.id}
            data-member-name={member.stageName}
            data-member-index={index}
          >
            <div class="relative w-full aspect-square overflow-hidden bg-neutral-900">
              <img
                src={member.image}
                alt={member.stageName}
                width="1000"
                height="1000"
                loading="lazy"
                class="w-full h-full object-cover object-center filter grayscale-[0.2] contrast-105 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#141418] via-transparent to-black/30 pointer-events-none" />
            </div>

            <div class="relative p-4 sm:p-5 flex flex-col justify-between flex-1 bg-[#141418]">
              <div class="space-y-1">
                <span class="text-[10px] sm:text-[11px] font-mono tracking-widest uppercase text-[#F8138D] font-semibold block">
                  {member.role}
                </span>
                <h3 class="text-xl sm:text-2xl font-display font-black tracking-tight text-white uppercase group-hover:text-[#F8138D] transition-colors leading-none">
                  {member.stageName}
                </h3>
                <p class="text-xs text-neutral-400 font-medium pt-0.5">
                  {member.fullName} <span class="text-white/20 mx-1">•</span> Born {member.birthDate}
                </p>
              </div>

              <div class="pt-3 mt-3 border-t border-white/10">
                <p class="text-xs text-neutral-300 italic font-light leading-relaxed line-clamp-2">
                  "{member.quote}"
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const memberNames = ['SOOBIN', 'YEONJUN', 'BEOMGYU', 'TAEHYUN', 'HUENINGKAI'];
  let currentActiveIndex = 0;

  function updateMemberBadge(index: number) {
    if (index === currentActiveIndex) return;
    currentActiveIndex = Math.max(0, Math.min(memberNames.length - 1, index));
    const badge = document.getElementById('member-active-indicator');
    if (badge) {
      badge.textContent = `0${currentActiveIndex + 1} / 05 • ${memberNames[currentActiveIndex]}`;
    }
  }

  function initHorizontalPin() {
    const section = document.getElementById('members-pinned-section');
    const container = document.getElementById('members-pin-container');
    const track = document.getElementById('members-track');
    const prevBtn = document.getElementById('btn-prev-member');
    const nextBtn = document.getElementById('btn-next-member');

    if (!section || !container || !track) return;

    const updatePin = () => {
      ScrollTrigger.getAll().forEach((st) => {
        if (st.vars.id === 'members-horizontal-pin') {
          st.kill();
        }
      });

      const totalScrollWidth = track.scrollWidth - window.innerWidth;
      if (totalScrollWidth > 0 && window.innerWidth >= 768) {
        const tl = gsap.timeline({
          scrollTrigger: {
            id: 'members-horizontal-pin',
            trigger: container,
            pin: section,
            scrub: 1,
            start: 'center center',
            end: () => `+=${totalScrollWidth + 1200}`,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              const p = self.progress;
              if (p < 0.20) {
                updateMemberBadge(0);
              } else if (p > 0.85) {
                updateMemberBadge(4);
              } else {
                const activeProgress = (p - 0.20) / 0.65;
                const idx = Math.min(4, Math.floor(activeProgress * 5));
                updateMemberBadge(idx);
              }
            },
          },
        });

        tl.to(track, {
          x: 0,
          duration: 0.5,
          ease: 'none',
        })
        .to(track, {
          x: () => -totalScrollWidth - 60,
          duration: 1.5,
          ease: 'none',
        })
        .to(track, {
          x: () => -totalScrollWidth - 60,
          duration: 0.4,
          ease: 'none',
        });

        const scrollToMember = (targetIdx: number) => {
          const st = ScrollTrigger.getById('members-horizontal-pin');
          if (!st) return;
          const clampedIdx = Math.max(0, Math.min(4, targetIdx));
          let targetProgress = 0;
          if (clampedIdx === 0) {
            targetProgress = 0.10;
          } else if (clampedIdx === 4) {
            targetProgress = 0.92;
          } else {
            targetProgress = 0.20 + (clampedIdx / 4) * 0.65;
          }
          const targetY = st.start + targetProgress * (st.end - st.start);
          window.scrollTo({ top: targetY, behavior: 'smooth' });
        };

        if (prevBtn) {
          prevBtn.onclick = () => scrollToMember(currentActiveIndex - 1);
        }
        if (nextBtn) {
          nextBtn.onclick = () => scrollToMember(currentActiveIndex + 1);
        }
      } else {
        gsap.set(track, { clearProps: 'transform' });

        if (prevBtn) {
          prevBtn.onclick = () => {
            container.scrollBy({ left: -300, behavior: 'smooth' });
          };
        }
        if (nextBtn) {
          nextBtn.onclick = () => {
            container.scrollBy({ left: 300, behavior: 'smooth' });
          };
        }
      }
    };

    updatePin();
    window.addEventListener('resize', updatePin);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHorizontalPin);
  } else {
    initHorizontalPin();
  }
</script>
