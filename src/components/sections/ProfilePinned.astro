---
import SectionHeading from '../ui/SectionHeading.astro';
import membersData from '../../data/members.json';
---

<section id="members-pinned-section" class="relative bg-[#0d0d10] min-h-screen flex flex-col justify-center overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 sm:px-12 w-full mb-2 sm:mb-4 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-mono font-semibold tracking-[0.25em] uppercase text-[#F8138D] mb-1.5">
        <span class="w-2 h-0.5 bg-[#F8138D]"></span>
        <span>We are</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-black tracking-tight text-white uppercase">
        TOMORROW X TOGETHER
      </h2>
      <p class="max-w-xl text-neutral-400 text-xs sm:text-sm leading-relaxed mt-1.5 line-clamp-2">
        TOMORROW X TOGETHER is composed of five shining members: SOOBIN, YEONJUN, BEOMGYU, TAEHYUN, and HUENINGKAI. Select any member to explore their complete deep-dive profile.
      </p>
    </div>

  </div>

  <div id="members-pin-container" data-lenis-prevent class="relative w-full overflow-x-auto md:overflow-hidden scrollbar-none overscroll-x-contain">
    <div
      id="members-track"
      class="flex gap-4 sm:gap-6 px-4 sm:px-12 w-max items-stretch py-4 select-none"
    >
      {
        membersData.map((member, index) => (
          <div
            class="member-card shrink-0 relative w-[80vw] max-w-[280px] sm:max-w-none sm:w-[280px] md:w-[300px] lg:w-[320px] rounded-2xl bg-[#141418] border border-white/10 overflow-hidden flex flex-col justify-between transition-all duration-500 hover:border-[#F8138D]/60 hover:shadow-[0_20px_45px_rgba(248,19,141,0.25)] hover:-translate-y-1.5 group cursor-pointer"
            data-member-id={member.id}
            data-member-name={member.stageName}
            data-member-index={index}
          >
            <div class="relative w-full aspect-square overflow-hidden bg-neutral-900 shrink-0">
              <img
                src={member.photoThumb || member.photoFull}
                alt={member.stageName}
                width="1000"
                height="1000"
                loading="lazy"
                class="w-full h-full object-cover object-center filter grayscale-[0.2] contrast-105 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#141418] via-transparent to-black/30 pointer-events-none" />
            </div>

            <div class="relative p-5 flex flex-col justify-between flex-1 bg-[#141418]">
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] sm:text-[11px] font-mono tracking-widest uppercase text-[#F8138D] font-bold block">
                    {member.role}
                  </span>
                </div>
                <h3 class="text-2xl font-display font-black tracking-tight text-white uppercase group-hover:text-[#F8138D] transition-colors leading-none">
                  {member.stageName}
                </h3>
                <p class="text-xs text-neutral-400 font-medium">
                  {member.fullName}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const memberNames = ['SOOBIN', 'YEONJUN', 'BEOMGYU', 'TAEHYUN', 'HUENINGKAI'];
  let currentActiveIndex = 0;

  function updateMemberBadge(index: number) {
    if (index === currentActiveIndex) return;
    currentActiveIndex = Math.max(0, Math.min(memberNames.length - 1, index));
    const badge = document.getElementById('member-active-indicator');
    if (badge) {
      badge.textContent = `0${currentActiveIndex + 1} / 05 • ${memberNames[currentActiveIndex]}`;
    }
  }

  function initHorizontalPin() {
    const section = document.getElementById('members-pinned-section');
    const container = document.getElementById('members-pin-container');
    const track = document.getElementById('members-track');

    if (!section || !container || !track) return;

    const getScrollDistance = () => Math.max(0, track.scrollWidth - window.innerWidth);

    const updatePin = () => {
      ScrollTrigger.getAll().forEach((st) => {
        if (st.vars.id === 'members-horizontal-pin') {
          st.kill();
        }
      });

      const totalScrollWidth = getScrollDistance();
      if (totalScrollWidth > 0 && window.innerWidth >= 768) {
        gsap.set(track, { clearProps: 'transform' });

        const tl = gsap.timeline({
          scrollTrigger: {
            id: 'members-horizontal-pin',
            trigger: section,
            pin: true,
            scrub: 1,
            start: 'top top',
            end: () => `+=${Math.max(totalScrollWidth * 1.5, 1200)}`,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              const p = self.progress;
              const idx = Math.min(4, Math.floor(p * 5));
              updateMemberBadge(idx);
            },
          },
        });

        tl.to(track, {
          x: () => -getScrollDistance(),
          ease: 'none',
        });
      } else {
        gsap.set(track, { clearProps: 'transform' });
      }
    };

    const cards = track.querySelectorAll('.member-card');
    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        const memberId = card.getAttribute('data-member-id');

        if (memberId) {
          window.dispatchEvent(new CustomEvent('open-member-modal', { detail: memberId }));
        }

        if (window.innerWidth >= 768) {
          const st = ScrollTrigger.getById('members-horizontal-pin');
          if (st) {
            const clampedIdx = Math.max(0, Math.min(4, idx));
            const targetProgress = (clampedIdx + 0.5) / 5;
            const targetY = st.start + targetProgress * (st.end - st.start);
            const lenis = (window as any).__lenis;
            if (lenis && typeof lenis.scrollTo === 'function') {
              lenis.scrollTo(targetY);
            } else {
              window.scrollTo({ top: targetY, behavior: 'smooth' });
            }
          }
        }
      });
    });

    updatePin();
    window.addEventListener('resize', updatePin);
    window.addEventListener('load', () => ScrollTrigger.refresh());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHorizontalPin);
  } else {
    initHorizontalPin();
  }
</script>
