---
---

<div id="brand-preloader" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-[#0a0a0a] text-white select-none overflow-hidden">
  <div id="preloader-curtain-top" class="absolute top-0 left-0 w-full h-1/2 bg-[#0a0a0a] z-0"></div>
  <div id="preloader-curtain-bottom" class="absolute bottom-0 left-0 w-full h-1/2 bg-[#0a0a0a] z-0"></div>

  <div id="preloader-glow" class="absolute w-72 h-72 rounded-full bg-[#F8138D] opacity-0 blur-[120px] pointer-events-none"></div>

  <div class="relative z-10 flex flex-col items-center justify-center">
    <div class="relative flex items-center justify-center h-28 w-80">
      <div id="txt-plus-left" class="absolute w-12 h-12 sm:w-14 sm:h-14 flex items-center justify-center opacity-0 pointer-events-none">
        <img
          src="/images/loader/plus-white.svg"
          alt="+"
          class="w-full h-full object-contain drop-shadow-[0_0_15px_rgba(255,255,255,0.7)]"
        />
      </div>

      <div id="txt-symbol-center" class="absolute w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center opacity-0 scale-50 pointer-events-none">
        <img
          src="/images/loader/plus-pink.svg"
          alt="+"
          class="w-full h-full object-contain drop-shadow-[0_0_22px_rgba(248,19,141,0.9)]"
        />
      </div>

      <div id="txt-plus-right" class="absolute w-12 h-12 sm:w-14 sm:h-14 flex items-center justify-center opacity-0 pointer-events-none">
        <img
          src="/images/loader/plus-white.svg"
          alt="+"
          class="w-full h-full object-contain drop-shadow-[0_0_15px_rgba(255,255,255,0.7)]"
        />
      </div>
    </div>

    <div id="preloader-text" class="mt-4 px-6 overflow-hidden flex items-center justify-center">
      <img
        id="txt-group-name"
        src="/images/loader/group-name.svg"
        alt="TOMORROW X TOGETHER"
        class="w-64 sm:w-80 md:w-96 h-auto object-contain opacity-0 transform translate-y-6 drop-shadow-[0_0_12px_rgba(255,255,255,0.3)]"
      />
    </div>
  </div>

  <button
    id="skip-preloader"
    class="absolute bottom-8 text-[11px] font-mono tracking-widest text-neutral-500 hover:text-[#F8138D] uppercase px-3 py-1.5 rounded-full border border-white/10 hover:border-[#F8138D]/40 transition-all cursor-pointer z-20"
  >
    SKIP INTRO [ESC]
  </button>
</div>

<script>
  import gsap from 'gsap';

  function initPreloader() {
    const preloader = document.getElementById('brand-preloader');
    const centerSymbol = document.getElementById('txt-symbol-center');
    const leftPlus = document.getElementById('txt-plus-left');
    const rightPlus = document.getElementById('txt-plus-right');
    const groupNameImg = document.getElementById('txt-group-name');
    const glow = document.getElementById('preloader-glow');
    const curtainTop = document.getElementById('preloader-curtain-top');
    const curtainBottom = document.getElementById('preloader-curtain-bottom');
    const skipBtn = document.getElementById('skip-preloader');

    if (!preloader || !centerSymbol) return;

    const tl = gsap.timeline({
      onComplete: () => {
        gsap.to(preloader, {
          autoAlpha: 0,
          duration: 0.3,
          onComplete: () => {
            preloader.style.display = 'none';
          },
        });
      },
    });

    // Phase 1: Simbol central + (pink) muncul di tengah (scale dari 0.4 ke 1.0, fade in)
    tl.to(centerSymbol, {
      opacity: 1,
      scale: 1,
      duration: 0.7,
      ease: 'back.out(1.7)',
    })
    .to(glow, {
      opacity: 0.45,
      duration: 0.5,
    }, '-=0.4')

    // Phase 2: Central + (pink) berputar 45° menjadi ×
    .to(centerSymbol, {
      rotate: 45,
      duration: 0.6,
      ease: 'power3.inOut',
    })

    // Phase 3: Dua simbol + (white) keluar meluncur dari balik × menuju sisi kiri dan kanan secara bersamaan hingga membentuk pola + × +
    .to(centerSymbol, {
      scale: 0.9,
      duration: 0.2,
    }, '-=0.2')
    .fromTo(leftPlus, 
      { opacity: 0, x: 0, scale: 0.5 },
      { opacity: 1, x: -75, scale: 1, duration: 0.6, ease: 'power3.out' }
    )
    .fromTo(rightPlus,
      { opacity: 0, x: 0, scale: 0.5 },
      { opacity: 1, x: 75, scale: 1, duration: 0.6, ease: 'power3.out' },
      '<'
    )

    // Phase 4: Teks nama group SVG muncul di bagian bawah dengan animasi fade-up
    .to(groupNameImg, {
      opacity: 1,
      y: 0,
      duration: 0.7,
      ease: 'power2.out',
    })

    // Hold for impact
    .to({}, { duration: 0.5 })

    // Phase 5: Preloader sliding up / membelah vertikal untuk membuka Hero Section
    .to([centerSymbol, leftPlus, rightPlus, groupNameImg, glow, skipBtn], {
      opacity: 0,
      scale: 0.9,
      duration: 0.4,
      ease: 'power2.in',
    })
    .to(curtainTop, {
      yPercent: -100,
      duration: 0.8,
      ease: 'power4.inOut',
    })
    .to(curtainBottom, {
      yPercent: 100,
      duration: 0.8,
      ease: 'power4.inOut',
    }, '<');

    const handleSkip = () => {
      tl.kill();
      sessionStorage.setItem('txt_intro_seen', 'true');
      gsap.to(preloader, {
        opacity: 0,
        duration: 0.3,
        onComplete: () => {
          preloader.style.display = 'none';
        },
      });
    };

    skipBtn?.addEventListener('click', handleSkip);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') handleSkip();
    });
  }

  // Run when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreloader);
  } else {
    initPreloader();
  }
</script>
