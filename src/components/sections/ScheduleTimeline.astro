---
import SectionHeading from '../ui/SectionHeading.astro';
import ScheduleSplitGrid from '../islands/ScheduleSplitGrid';
---

<section id="schedule-section" class="relative bg-[#0a0a0c] py-24 px-6 sm:px-12 border-t border-white/5 overflow-hidden">
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[350px] bg-[#962a64]/10 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <SectionHeading
      subtitle="ACT : PROMISE World Tour"
      title="SCHEDULE & ITINERARY"
      align="center"
    />
    <p class="max-w-2xl mx-auto text-center text-neutral-400 text-xs sm:text-sm -mt-6 mb-12">
      Experience TOMORROW X TOGETHER live on stage. Explore confirmed stadium & arena dates, countdown to upcoming shows, and secure official concert tickets.
    </p>

    <ScheduleSplitGrid client:visible />
  </div>
</section>
