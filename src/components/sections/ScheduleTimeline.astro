---
import SectionHeading from '../ui/SectionHeading.astro';
import ScheduleHub from '../islands/ScheduleHub';
---

<section id="schedule-section" class="relative bg-[#0a0a0c] py-24 px-6 sm:px-12 border-t border-white/5 overflow-hidden">
  {/* Ambient background glow with mint accent */}
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[350px] bg-[#00E59B]/5 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <SectionHeading
      subtitle="Interactive Tour Calendar"
      title="SCHEDULE & ITINERARY"
      align="center"
    />
    <p class="max-w-2xl mx-auto text-center text-neutral-400 text-xs sm:text-sm -mt-6 mb-12">
      Explore official world tour stages, fan meetings, and media premieres. Select any date from the interactive strip to inspect venue details and ticket status.
    </p>

    {/* Hybrid Interactive Tour Calendar Strip Island */}
    <ScheduleHub client:visible />
  </div>
</section>
