---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import productsData from '../../data/products.json';
---

<section id="shop-preview-section" class="relative bg-[#0d0d10] py-24 px-6 sm:px-12 border-t border-white/5 overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <SectionHeading
        subtitle="Official Store"
        title="EXCLUSIVE MERCHANDISE"
        align="left"
        class="mb-0 md:mb-0"
      />
      <div class="mt-6 md:mt-0">
        <Button href="/store" variant="outline" size="md">
          Explore All Products →
        </Button>
      </div>
    </div>

    {/* Featured Products Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        productsData.slice(0, 3).map((product) => (
          <a
            href="/store"
            class="group relative bg-[#131317] border border-white/10 rounded-2xl overflow-hidden hover:border-[#00e5ff]/50 transition-all duration-300 hover:shadow-[0_15px_35px_rgba(0,0,0,0.8)] flex flex-col"
          >
            {/* Image */}
            <div class="relative aspect-square w-full bg-black/50 overflow-hidden">
              <img
                src={product.image}
                alt={product.name}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-50 group-hover:opacity-30 transition-opacity" />

              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase bg-black/70 backdrop-blur-md text-[#00e5ff] border border-white/10">
                  {product.category}
                </span>
              </div>
            </div>

            {/* Info */}
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <h3 class="text-base font-semibold text-white group-hover:text-[#00e5ff] transition-colors">
                  {product.name}
                </h3>
                <p class="text-xs text-neutral-400 mt-1 line-clamp-2 leading-relaxed">
                  {product.description}
                </p>
              </div>

              <div class="flex items-center justify-between pt-3 border-t border-white/5">
                <div>
                  <span class="text-xs text-neutral-500 block">Official Price</span>
                  <span class="text-lg font-bold font-mono text-white">
                    ${product.price.toFixed(2)} USD
                  </span>
                </div>
                <span class="text-xs font-semibold text-[#00e5ff] group-hover:translate-x-1 transition-transform">
                  View in Store →
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
