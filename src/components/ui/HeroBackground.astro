---
interface Props {
  topSubtitle?: string;
  largeTextPrimary?: string;
  largeTextSecondary?: string;
}

const {
  topSubtitle = 'ACT : PROMISE ERA',
  largeTextPrimary = 'TOMORROW X TOGETHER',
  largeTextSecondary = 'THE NAME CHAPTER • PROMISE',
} = Astro.props;
---

<div class="absolute inset-0 overflow-hidden pointer-events-none select-none z-0">
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-b from-[#F8138D]/15 via-transparent to-transparent rounded-full blur-[140px]"></div>

  <div class="absolute inset-0 flex flex-col justify-center items-center opacity-15 overflow-hidden">
    <div class="whitespace-nowrap font-display font-black text-[12vw] tracking-tighter text-white leading-none">
      {largeTextPrimary}
    </div>
    <div class="whitespace-nowrap font-display font-black text-[10vw] tracking-tight text-white/50 leading-none">
      {largeTextSecondary}
    </div>
  </div>

  <div class="absolute top-24 left-[8%] text-[#F8138D] text-2xl font-bold opacity-50">
    +
  </div>
  <div class="absolute top-36 right-[10%] text-white text-3xl font-bold opacity-30">
    +
  </div>
  <div class="absolute bottom-40 left-[12%] text-white text-4xl font-bold opacity-25">
    ×
  </div>
  <div class="absolute bottom-32 right-[12%] text-[#f570b7] text-2xl font-bold opacity-40">
    +
  </div>

  <div class="absolute top-24 inset-x-0 max-w-7xl mx-auto px-6 hidden sm:flex justify-between items-center text-[10px] font-mono tracking-[0.25em] uppercase text-neutral-500">
    <span class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#F8138D] animate-ping"></span>
      {topSubtitle}
    </span>
    <span>BIG HIT MUSIC • HYBE</span>
  </div>
</div>
