---
interface Props {
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  rel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className = '',
  id,
  type = 'button',
  target,
  rel,
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium transition-all duration-300 select-none tracking-wider uppercase disabled:opacity-50 disabled:pointer-events-none cursor-pointer';

const sizeStyles = {
  sm: 'text-xs px-3.5 py-1.5 rounded-[var(--radius-sm)] gap-1.5',
  md: 'text-sm px-5 py-2.5 rounded-[var(--radius-md)] gap-2',
  lg: 'text-base px-8 py-3.5 rounded-[var(--radius-md)] gap-2.5 font-semibold',
};

const variantStyles = {
  primary: 'bg-[var(--color-accent-blue)] text-black hover:bg-[var(--color-accent-neon)] hover:shadow-[0_0_20px_rgba(0,229,255,0.4)] active:scale-[0.98]',
  outline: 'border border-[var(--color-border)] text-white hover:border-[var(--color-accent-blue)] hover:text-[var(--color-accent-blue)] hover:bg-[rgba(0,229,255,0.06)] active:scale-[0.98]',
  ghost: 'text-neutral-400 hover:text-white hover:bg-white/5 active:scale-[0.98]',
};

const combinedClasses = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={combinedClasses} id={id} target={target} rel={rel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={combinedClasses} id={id}>
      <slot />
    </button>
  )
}
